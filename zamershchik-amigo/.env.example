# ─── Сервер ───────────────────────────────────────────────────────────────
# Порт и адрес. 0.0.0.0 — чтобы приложение открывалось на телефоне по локальной сети
HOST=0.0.0.0
PORT=3000

# Внешний адрес приложения. Нужен, чтобы в письмах были кликабельные ссылки.
# Пример: http://192.168.1.50:3000  или  https://zamery.amigo.ru
PUBLIC_URL=

# ─── Замерщики (вход по PIN) ──────────────────────────────────────────────
# Создаётся автоматически при первом запуске, если файл data/users.json пуст.
# Потом добавляйте людей командой:  npm run pin -- --name "Иван" --pin 4321
BOOTSTRAP_NAME=Замерщик
BOOTSTRAP_PIN=0000

# Сколько часов живёт вход на телефоне
TOKEN_TTL_HOURS=720

# ─── База знаний: Amigo Customizer API ────────────────────────────────────
# Этот адрес отдаёт каталог (системы/модели/ткани/опции) и живой расчёт цены.
AMIGO_BASE=https://1c87433dfbfcece8e76a55b998f72ec9.customizer.amigo.ru
AMIGO_TIMEOUT_MS=15000

# Логин сотрудника-дилера в Amigo Customizer.
# БЕЗ ЭТОГО не работают системы «Шторы плиссе» и «Шторы гофре»:
# анонимно Amigo отдаёт для них пустой список тканей.
# Укажите тот же логин, которым входите в конфигуратор.
AMIGO_LOGIN=
AMIGO_PASS=
# Как часто обновлять каталог из Amigo (секунды)
CATALOG_TTL_SEC=1800

# ─── Валюта ───────────────────────────────────────────────────────────────
# Прайс Amigo ведётся в ДОЛЛАРАХ — в самой системе отчёты подписаны
# «На сумму, USD», «Наценка, USD». Метка "RUB" в ответе /api/calculate
# на анонимный запрос — валюта по умолчанию для гостя, а не ваша.
PRICE_SOURCE_CURRENCY=USD
PRICE_TARGET_CURRENCY=RUB

# Курс берём у ЦБ РФ автоматически, каждый раз свежий, ключи не нужны
RATE_PROVIDER=cbr
RATE_TTL_HOURS=12

# Если нужен СВОЙ курс (например, курс от поставщика) — заполните USD_RATE.
# Как только он задан, он важнее автоматического.
# USD_RATE=95.50

# Адрес источника курса (если используете не ЦБ РФ)
RATE_URL=https://www.cbr-xml-daily.ru/daily_json.js

# ─── Почта (SMTP) ────────────────────────────────────────────────────────
# В Яндекс/Google/Mail.ru: настройки ящика → "Пароль приложения".
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=zamery@company.ru
SMTP_PASS=ТУТ_ПАРОЛЬ_ПРИЛОЖЕНИЯ

# Куда приходят заявки (можно несколько через запятую)
MAIL_TO=zamery@company.ru

# От кого уходит письмо
MAIL_FROM="Замеры <zamery@company.ru>"

MAIL_SUBJECT_PREFIX=Заявка с замера

# ─── База (Supabase) ───────────────────────────────────────────────────────
# Без этих переменных приложение работает на локальных JSON-файлах — так удобно
# при разработке и в макете. На Render файловая система временная, поэтому
# для деплоя базу нужно указать обязательно.
SUPABASE_URL=
SUPABASE_KEY=

# ─── Хранилище ────────────────────────────────────────────────────────────
DATA_DIR=
UPLOAD_LIMIT_MB=25